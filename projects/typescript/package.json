  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "pnpm --recursive --if-present check",
    "console-return-mechanics": "node packages/data-compiler/src/cli.ts console-return-mechanics",
    "checkout-income": "node packages/data-compiler/src/cli.ts checkout-income",
    "customer-shopping-mechanics": "node packages/data-compiler/src/cli.ts customer-shopping-mechanics",
    "film-catalog": "node packages/data-compiler/src/cli.ts film-catalog",
    "level-progression": "node packages/data-compiler/src/cli.ts level-progression",
    "market-guide-findings": "node packages/data-compiler/src/cli.ts market-guide-findings",
    "market-mechanics": "node packages/data-compiler/src/cli.ts market-mechanics",
    "market-rental-economics": "node packages/data-compiler/src/cli.ts market-rental-economics",
    "market-value-analysis": "node packages/data-compiler/src/cli.ts market-value-analysis",
    "membership-fee-mechanics": "node packages/data-compiler/src/cli.ts membership-fee-mechanics",
    "movie-return-mechanics": "node packages/data-compiler/src/cli.ts movie-return-mechanics",
    "movie-return-validated-mechanics": "node packages/data-compiler/src/cli.ts movie-return-validated-mechanics",
    "new-release-mechanics": "node packages/data-compiler/src/cli.ts new-release-mechanics",
    "movie-return-validation": "node packages/validator/src/cli.ts movie-return",
    "test": "pnpm --recursive --if-present test"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.x",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.19.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
