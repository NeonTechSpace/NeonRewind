<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Cue4ParseVersion>1.2.2.202607</Cue4ParseVersion>
    <AssemblyName>NeonRetroRewind.StaticExtractor</AssemblyName>
    <RootNamespace>NeonRetroRewind.StaticExtractor</RootNamespace>
    <Version>0.0.6</Version>
    <AssemblyVersion>0.0.6.0</AssemblyVersion>
    <FileVersion>0.0.6.0</FileVersion>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="Cue4ParsePackageVersion" Value="$(Cue4ParseVersion)" />
    <AssemblyMetadata Include="ExtractorVersion" Value="$(Version)" />
    <PackageReference Include="CUE4Parse" Version="$(Cue4ParseVersion)" />
    <!-- Overrides IndexRange 1.1.0's vulnerable Microsoft.Bcl.Memory 9.0.0 floor. -->
    <PackageReference Include="Microsoft.Bcl.Memory" Version="9.0.18" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
